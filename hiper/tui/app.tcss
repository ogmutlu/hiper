Screen {
    background: $background;
}
Header {
    background: $surface;
    color: $text;
}
#summary {
    height: 3;
    padding: 0 2;
    color: $text-muted;
    background: $surface;
}
#workspace {
    height: 1fr;
}
TabPane {
    padding: 0 2;
}
VerticalScroll {
    height: 1fr;
}
.card {
    height: auto;
    border: round $accent;
    padding: 1 2;
    margin: 1 0;
    background: $surface;
}
.eyebrow {
    height: auto;
    color: $accent;
    text-style: bold;
    margin-top: 1;
}
.section-title {
    height: auto;
    text-style: bold;
    margin: 1 0;
}
.hint {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
.field-label {
    height: 1;
    color: $text-muted;
}
Input {
    margin-bottom: 1;
}
#timer {
    height: 3;
    content-align: left middle;
    text-style: bold;
    color: $accent;
}
#session-state, #session-detail {
    height: auto;
}
#session-detail {
    color: $text-muted;
}
.buttons Button {
    width: 1fr;
    min-width: 10;
}
.buttons {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
}
Button {
    margin-right: 1;
}
RecordTable {
    height: 12;
    min-height: 5;
    margin: 1 0;
    border: round $surface-lighten-2;
}
#status {
    height: auto;
    max-height: 3;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
}
#status.error {
    color: $error;
}
SessionDecision, DeleteDecision {
    align: center middle;
    background: $background 75%;
}
#decision {
    width: 64;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}
#decision .buttons {
    margin-top: 1;
}
#decision Button {
    min-width: 12;
    padding: 0 1;
}
